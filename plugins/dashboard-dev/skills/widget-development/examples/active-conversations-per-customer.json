      "oasis": {
        "datasets": [
          "devrev.dim_conversation",
          "devrev.dim_revu_slim",
          "devrev.dim_revo"
        ],
        "sql_query": "SELECT t.id, t.object_type as type,  t.created_date,  t.owned_by_ids, t.participant_oids, t.created_by_id, t.tags_json, t.\"group\" as group_ticket, t.source_channel, t.stage_json, dim_revo.account, dim_revo.id as rev_oid, FROM devrev.dim_conversation as t LEFT JOIN devrev.dim_revu_slim dim_revu ON dim_revu.id = t.created_by_id LEFT JOIN devrev.dim_revo ON dim_revo.id = t.participant_oids[1] WHERE t.state !='closed' AND dim_revo.account IS NOT NULL"
      },
      "reference_name": "dim_conversation",
      "type": "oasis"
    }
